# FreeGLM credential template — intentionally contains no values.
#
# Preferred setup (hidden input, saved to ~/.freeglm/config with mode 0600):
#   bash install.sh configure
#
# Temporary shell-only setup without putting a key in shell history:
#   read -rsp "ZHIPU_API_KEY: " ZHIPU_API_KEY && printf '\n' && export ZHIPU_API_KEY
#
# If you copy this file to .env, keep it local (it is gitignored), chmod 600 it, and source it
# explicitly. FreeGLM does not automatically load a project .env file.

# Choose at least one VL provider. When both are set, DashScope is the default.
ZHIPU_API_KEY=
DASHSCOPE_API_KEY=

# Required only for freeglm-search.
SERPER_API_KEY=

# Optional user-controlled endpoints. Do not put endpoints or credentials in prompts/tool calls.
ZHIPU_BASE_URL=
DASHSCOPE_BASE_URL=

# Optional OSS credentials for sending large media by signed URL.
OSS_AK=
OSS_SK=
OSS_ENDPOINT=
OSS_BUCKET=
