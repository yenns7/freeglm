{
  "name": "freeglm-freecad",
  "version": "1.0.0",
  "description": "FreeCAD parametric CAD: create/edit objects, execute Python, named-view screenshots, parts library, and CalculiX FEM as MCP tools + a skill.",
  "author": {
    "name": "yenns7",
    "url": "https://github.com/yenns7/freeglm"
  },
  "skills": "./skill",
  "mcpServers": {
    "freeglm-freecad": {
      "command": "uvx",
      "args": [
        "--from",
        "freeglm[freecad] @ git+https://github.com/yenns7/freeglm.git@main",
        "freeglm-freecad"
      ],
      "env": {
        "FREEGLM_AUTOLAUNCH": "1"
      }
    }
  }
}
